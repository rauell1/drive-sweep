<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (slug: installer).
  Signs DriveSweep-Setup-<version>.exe after it has been built from the already signed exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="DriveSweep-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
